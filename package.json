{
  "name": "portal-medico",
  "private": true,
  "version": "1.4.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/missingc0de/portalmedico.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron electron/main.cjs\"",
    "start:offline": "vite build && cls && echo La aplicacion esta corriendo localmente en http://localhost:3000 sin internet. && npx serve -s dist",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.portalmedico.app",
    "productName": "PORTAL MÉDICO",
    "directories": {
      "output": "dist-electron-release-v1030"
    },
    "icon": "electron/portalmedico_icon_256.png",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "missingc0de",
        "repo": "portalmedico",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^1.45.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "app-builder-bin": "^5.0.0-alpha.12",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.4",
    "electron-updater": "^6.8.3",
    "file-saver": "^2.0.5",
    "firebase": "^12.11.0",
    "jspdf": "2.5.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.576.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "wait-on": "^9.0.4"
  }
}
